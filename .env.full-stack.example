# Full-stack Docker Compose environment example
# Copy to .env next to docker-compose.yml:
#   cp .env.full-stack.example .env
#
# See docs/getting-started.md

# ------------------------------------------------------------------------------
# Public URLs (browser-facing)
# FRONTEND_URL = Admin UI (not the Storefront)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8081
NUXT_USER_BASE_URL=http://localhost:3000
NUXT_PUBLIC_USER_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
DISABLE_EMAIL_CHECK=true
NUXT_CACHE_ENABLED=false

# ------------------------------------------------------------------------------
# Secrets — change these before any shared or production use
# Generate examples:
#   openssl rand -hex 16   # CRYPTO_SECRET (32 hex chars)
#   openssl rand -hex 64   # JWT secrets
# ------------------------------------------------------------------------------
CRYPTO_SECRET=CHANGE_ME__32__CHARS_RANDOM_SECRET
JWT_SECRET=CHANGE_ME__LONG_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME__LONG_RANDOM_JWT_REFRESH_SECRET
JWT_ALGORITHM=HS512
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=smart-city-booking
JWT_AUDIENCE=smart-city-api

# ------------------------------------------------------------------------------
# Initial admin (created on first backend start if missing)
# ------------------------------------------------------------------------------
INIT_ADMIN=admin@example.com
INIT_ADMIN_SECRET=CHANGE_ME__STRONG_ADMIN_PASSWORD

# ------------------------------------------------------------------------------
# Admin UI branding (optional)
# ------------------------------------------------------------------------------
VUE_APP_NAME=Smart City Booking
VUE_APP_IS_PRODUCTION=true

# ------------------------------------------------------------------------------
# Nextcloud (optional — required for uploads and payment PDFs)
# See docs/nextcloud.md
# ------------------------------------------------------------------------------
# NEXTCLOUD_URL=http://localhost:9500
# NEXTCLOUD_USERNAME=CHANGE_ME__NEXTCLOUD_USER
# NEXTCLOUD_PASSWORD=CHANGE_ME__NEXTCLOUD_PASSWORD
