# ==============================================================================
#  EXAMPLE CONFIGURATION (.env.example)
#  Copy this file to .env and adjust the values to your needs.
#
#  Notes:
#  - Do not commit real secrets (CRYPTO_SECRET, JWT_*, passwords) to version control.
#  - Use strong, random values in production.
# ==============================================================================

# GENERAL CONFIGURATION
# ==============================================================================

# The port the server will listen on
PORT=8081

# The log level. Possible values: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug

# Public base URLs (used for redirects/callbacks)
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8081

# Secret used to encrypt / decrypt data (32 chars)
# Generate example: openssl rand -hex 16
CRYPTO_SECRET=CHANGE_ME__32__CHARS_RANDOM_SECRET

# DATABASE CONFIGURATION
# ==============================================================================

# MongoDB connection string
# Examples:
# - Local:  mongodb://localhost:27017/booking-manager
# - Atlas:  mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/booking-manager?retryWrites=true&w=majority
DB_URL=mongodb://localhost:27017/booking-manager

# Database name inside the MongoDB instance
DB_NAME=booking-manager

# NEXTCLOUD CONFIGURATION
# ==============================================================================

# Base URL of the Nextcloud instance
NEXTCLOUD_URL=http://localhost:9500

# Credentials of the Nextcloud user used to upload files
NEXTCLOUD_USERNAME=CHANGE_ME__NEXTCLOUD_USER
NEXTCLOUD_PASSWORD=CHANGE_ME__NEXTCLOUD_PASSWORD

# LIMITS (optional)
# If empty, the system will not enforce a limit.
MAX_TENANTS=1
MAX_BOOKABLES=10
MAX_EVENTS=

# INITIAL ADMIN USER (bootstrap)
# ==============================================================================
# If this user does not exist, it will be created on startup.
#
# Defaults (when not set):
# - INIT_ADMIN=admin
# - INIT_ADMIN_SECRET=admin
#
# Recommendation:
# If you plan to keep using this init admin after the initial setup, set INIT_ADMIN
# to a valid email address so the user can receive emails (e.g. password reset).
#
# Defaults (when not set): admin / admin
INIT_ADMIN=admin@example.com
INIT_ADMIN_SECRET=CHANGE_ME__STRONG_ADMIN_PASSWORD

# EMAIL CHECK (dev/test)
# If true, the endpoint /check-email will skip checks and always respond with 200 OK.
# Do not enable in production.
DISABLE_EMAIL_CHECK=true

# JWT CONFIGURATION
# ==============================================================================

# JWT signing secret (use a long random value)
# Generate example: openssl rand -hex 64
JWT_SECRET=CHANGE_ME__LONG_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME__LONG_RANDOM_JWT_REFRESH_SECRET

# JWT algorithm
JWT_ALGORITHM=HS512

# Token lifetimes (e.g. 15m, 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT claims
JWT_ISSUER=smart-city-booking
JWT_AUDIENCE=smart-city-api

# RULE ENGINE CONFIGURATION
# ==============================================================================

# Enables the rule engine (scheduled rules). Possible values: true, false
RULE_ENGINE_ENABLED=false

# Retention period for rule execution logs in seconds (default: 90 days)
RULE_LOG_TTL_SECONDS=7776000

# Maximum number of per-document action results stored in a single execution log
RULE_MAX_ACTION_RESULTS=500