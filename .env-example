# ==============================================================================
#  EXAMPLE CONFIGURATION (.env.example)
#  Copy this file to .env and adjust the values to your needs.
#
#  Notes:
#  - Do not commit real secrets (CRYPTO_SECRET, JWT_*, passwords) to version control.
#  - Use strong, random values in production.
# ==============================================================================

# GENERAL CONFIGURATION
# ==============================================================================

# The port the server will listen on
PORT=8081

# The log level. Possible values: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug

# Public base URLs (used for redirects/callbacks)
# FRONTEND_URL = Admin UI base URL (vue-app), NOT the Storefront — v3 and v4.
# Storefront uses its own NUXT_* URLs; see docs/getting-started.md
FRONTEND_URL=http://localhost:8080
# Public API URL. Admin: VUE_APP_SERVER_BASE_URL; Storefront BFF: NUXT_API_BASE_URL
BACKEND_URL=http://localhost:8081

# Public base URL of the store-front. Used to build the QR code / scan URL
# (https://<STORE_FRONT_URL>/mobile-key/<tenant>/<scanCode>). This is the
# store-front, not the Vue admin app that FRONTEND_URL points at.
STORE_FRONT_URL=http://localhost:8082

# Secret used to encrypt / decrypt data (32 chars)
# Generate example: openssl rand -hex 16
CRYPTO_SECRET=CHANGE_ME__32__CHARS_RANDOM_SECRET

# DATABASE CONFIGURATION
# ==============================================================================

# MongoDB connection string
# Examples:
# - Local:  mongodb://localhost:27017/booking-manager
# - Atlas:  mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/booking-manager?retryWrites=true&w=majority
DB_URL=mongodb://localhost:27017/booking-manager

# Database name inside the MongoDB instance
DB_NAME=booking-manager

# NEXTCLOUD CONFIGURATION (required for file uploads & PDF documents)
# ==============================================================================
# Nextcloud is used as external file storage via WebDAV. Required when you use:
# - Image and file uploads (e.g. bookable images, booking attachments)
# - Generated PDFs: receipts, invoices, cancellations
# - Instance/tenant file management (legal documents, public assets)
# See docs/nextcloud.md for details.

# Base URL of the Nextcloud instance (no trailing slash)
NEXTCLOUD_URL=http://localhost:9500

# WebDAV credentials for the dedicated Nextcloud service user
NEXTCLOUD_USERNAME=CHANGE_ME__NEXTCLOUD_USER
NEXTCLOUD_PASSWORD=CHANGE_ME__NEXTCLOUD_PASSWORD

# MEDIA STORAGE (media library)
# ==============================================================================
# Where new media uploads are stored: "nextcloud" (default) or "s3".
# Existing media keep the provider they were uploaded to — switching only
# affects new uploads. Setting this explicitly makes the boot fail when the
# chosen provider's configuration is incomplete.
#STORAGE_PROVIDER=nextcloud

# S3 / S3-compatible storage (MinIO is pure configuration: endpoint +
# forced path style). Required when STORAGE_PROVIDER=s3.
#S3_BUCKET=smart-city-booking-media
#S3_REGION=eu-central-1
# Static credentials are optional — omit both to use the AWS default
# credential chain (IAM role, instance profile, …).
#S3_ACCESS_KEY_ID=CHANGE_ME__S3_ACCESS_KEY_ID
#S3_SECRET_ACCESS_KEY=CHANGE_ME__S3_SECRET_ACCESS_KEY
# Custom endpoint for MinIO and other S3-compatible services
#S3_ENDPOINT=http://localhost:9000
#S3_FORCE_PATH_STYLE=true

# MEDIA UPLOADS (media library)
# ==============================================================================
# Upload limits per media kind, in megabytes.
#MEDIA_MAX_IMAGE_SIZE_MB=15
#MEDIA_MAX_DOCUMENT_SIZE_MB=50

# Global upload backstop for every upload route, in megabytes. Defaults to the
# largest limit above plus 5 MB — keep it above them so media uploads answer
# with a proper error instead of a truncated request.
#MEDIA_UPLOAD_BACKSTOP_SIZE_MB=55

# Image processing (sharp). The pixel ceiling guards against decompression
# bombs, the thread pool keeps upload latency predictable in containers.
#MEDIA_IMAGE_MAX_PIXELS=50000000
#MEDIA_SHARP_CONCURRENCY=1

# LIMITS (optional)
# If empty, the system will not enforce a limit.
MAX_TENANTS=1
MAX_BOOKABLES=10
MAX_EVENTS=

# INITIAL ADMIN USER (bootstrap)
# ==============================================================================
# If this user does not exist, it will be created on startup.
#
# Defaults (when not set):
# - INIT_ADMIN=admin
# - INIT_ADMIN_SECRET=admin
#
# Recommendation:
# If you plan to keep using this init admin after the initial setup, set INIT_ADMIN
# to a valid email address so the user can receive emails (e.g. password reset).
#
# Defaults (when not set): admin / admin
INIT_ADMIN=admin@example.com
INIT_ADMIN_SECRET=CHANGE_ME__STRONG_ADMIN_PASSWORD

# EMAIL CHECK (dev/test)
# If true, the endpoint /check-email will skip checks and always respond with 200 OK.
# Do not enable in production.
DISABLE_EMAIL_CHECK=true

# JWT CONFIGURATION
# ==============================================================================

# JWT signing secret (use a long random value)
# Generate example: openssl rand -hex 64
JWT_SECRET=CHANGE_ME__LONG_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME__LONG_RANDOM_JWT_REFRESH_SECRET

# JWT algorithm
JWT_ALGORITHM=HS512

# Token lifetimes (e.g. 15m, 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT claims
JWT_ISSUER=smart-city-booking
JWT_AUDIENCE=smart-city-api

# RULE ENGINE CONFIGURATION
# ==============================================================================

# Enables the rule engine (scheduled rules). Possible values: true, false
RULE_ENGINE_ENABLED=false

# Retention period for rule execution logs in seconds (default: 90 days)
RULE_LOG_TTL_SECONDS=7776000

# Maximum number of per-document action results stored in a single execution log
RULE_MAX_ACTION_RESULTS=500

# ==============================================================================
# Access Points
# ==============================================================================
# If true, access points will inherit access points from their parents.
ACCESS_POINTS_INHERIT_PARENTS=true
ACCESS_POINTS_INHERIT_CHILDREN=true

# Public backend URL used for provider webhook callbacks.
# Falls back to BACKEND_URL when empty.
ACCESS_WEBHOOK_BASE_URL=

# Salto KS hosts per environment (tenants pick "accept" or "production").
# Leave empty to use Salto's published hosts; set only if Salto moves one.
SALTO_ACCEPT_API_BASE_URL=
SALTO_ACCEPT_IDENTITY_URL=
SALTO_PRODUCTION_API_BASE_URL=
SALTO_PRODUCTION_IDENTITY_URL=
# Salto KS orphaned-user cleanup.
SALTO_KS_CLEANUP_ENABLED=true
SALTO_KS_CLEANUP_INTERVAL_MS=3600000
